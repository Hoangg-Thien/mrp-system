# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Database Configuration (used by docker-compose and Spring Boot datasource)
DB_NAME=mrp
DB_USERNAME=postgres
DB_PASSWORD=your_strong_postgres_password_here
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/mrp

# JWT Security (secret must be at least 256 bits / 32 characters)
JWT_SECRET=mrp-system-very-secure-jwt-secret-key-must-be-at-least-256-bits-long-2026
JWT_EXPIRATION_SECONDS=86400

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial admin is created only when the users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_please
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
